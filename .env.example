# Public site URL (metadata, canonical links, NextAuth in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# USD → MAD conversion for Arabic locale pricing (server-side)
USD_TO_MAD_RATE=10

# Supabase (create a new project and run supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin auth: in dev, login is skipped automatically until NEXT_PUBLIC_SUPABASE_URL is set.
# Force skip (or keep skip after Supabase): ATLAS_SKIP_ADMIN_AUTH=true
# Force login in dev: ATLAS_SKIP_ADMIN_AUTH=false

# Default admin after migration (change password in production):
# admin@atelier-atlas.com / AtelierAtlas#2026
